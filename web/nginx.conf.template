# openGym — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).
#
# Rendered by the nginx image's own entrypoint, which envsubst's the files in
# /etc/nginx/templates. The backend is one variable, API_UPSTREAM (host:port), not the
# upstream BACKEND/PORT pair: Render injects its own PORT into the web container, which
# would silently repoint the proxy. Compose builds API_UPSTREAM from BACKEND and PORT in
# .env (see docker-compose.yml), so renaming the api service still works; Render passes
# the private service's hostport directly (see render.yaml).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # API → backend container
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Exercise images/GIFs never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
