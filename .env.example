# openGym — copy to .env and adjust:  cp .env.example .env
#
# Passkeys (WebAuthn) are bound to an exact hostname and need HTTPS, with
# http://localhost as the only exception. RP_ID and ORIGIN must match the URL
# in the address bar exactly, or login fails with "verification failed".
# Changing RP_ID later invalidates every passkey already registered.

# --- required ---------------------------------------------------------------
RP_ID=localhost                    # hostname only, no scheme, no port
ORIGIN=http://localhost:8080       # full origin, must include the port
RP_NAME=openGym                    # shown in the browser's passkey prompt
WEB_PORT=8080                      # host port for the web container

# --- optional ---------------------------------------------------------------
# Users listed here get the admin dashboard. Register your passkey first, then
# find your id in ./data/db.json under users[].id. Comma-separated.
#ADMIN_UIDS=

# Require an invite code to create a profile. Existing accounts keep working.
#INVITE_ONLY=1

# Session cookie lifetime in days. Default 90, minimum 1.
#SESSION_DAYS=90

# Contact subject for Web Push (VAPID). Defaults to ORIGIN over HTTPS, or
# mailto:admin@localhost otherwise. The keys themselves are generated on first
# run into ./data/vapid.json — nothing to set up.
#VAPID_SUBJECT=mailto:you@example.com
